{
  "name": "concilium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Concilium — Vaticanum II in context. Local-first study PWA for the 16 documents of the Second Vatican Council.",
  "scripts": {
    "predev": "node scripts/validate-content.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/validate-content.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "build:preview": "node scripts/validate-content.mjs && vite build --mode artifact --outDir dist-artifact"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "i18next": "^23.16.8",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
